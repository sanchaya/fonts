<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Engine Inspector - ಫಾಂಟ್ಸ್ ಸಂಚಯ</title>
    <base href="/">
    <link rel="icon" type="image/png" href="/img/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/img/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/img/android-chrome-512x512.png">
    <meta name="msapplication-TileImage" content="/img/mstile-310x310.png">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="/js/home.js"></script>
    <style>
        .ei-tool-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
        }
        .ei-tool-title {
            text-align: center;
            color: var(--primary-color);
            font-size: 2.2rem;
            margin-bottom: 8px;
        }
        .ei-tool-sub {
            text-align: center;
            color: var(--span-color);
            font-size: 1rem;
            margin-bottom: 24px;
        }
        .ei-file-input {
            padding: 8px 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            background: var(--third-color);
            color: var(--text-color1);
            outline: none;
            width: 100%;
        }
        .ei-select {
            padding: 8px 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            background: var(--third-color);
            color: var(--text-color1);
            outline: none;
            width: 100%;
        }
        .ei-upload-hint {
            font-size: 12px;
            color: var(--span-color);
            margin-top: 4px;
        }
        .engine-inspector-inline .ei-render-card {
            flex: 1;
            min-width: 0;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="ei-tool-container">
        <h1 class="ei-tool-title">ಎಂಜಿನ್ ತಪಾಸಣೆ / Engine Inspector</h1>
        <p class="ei-tool-sub">
            Compare how any Kannada font renders in your browser vs the HarfBuzz reference engine — kerning, shaping and glyph metrics.
        </p>

        <div class="engine-inspector-inline">
            <div class="ei-card">
                <span class="ei-card-title">Upload &amp; Configure</span>
                <p class="ei-description">
                    Upload a <strong>.ttf</strong> or <strong>.otf</strong> font file and see it rendered side-by-side by your browser
                    and HarfBuzz, then inspect the raw glyph shaping data.
                </p>

                <div class="ei-controls" style="grid-template-columns: 1fr 2fr 100px;">
                    <div class="ei-control-group">
                        <label class="ei-label">Font file (.ttf/.otf)</label>
                        <input type="file" class="ei-file-input" id="ei-font-upload" accept=".ttf,.otf">
                    </div>
                    <div class="ei-control-group">
                        <label class="ei-label">Test string</label>
                        <select class="ei-select" id="ei-test-string-select">
                            <option value="">— pick a curated test string —</option>
                        </select>
                    </div>
                    <div class="ei-control-group">
                        <label class="ei-label">Font size (px)</label>
                        <input type="number" class="ei-input" id="ei-font-size" value="72" min="12" max="200">
                    </div>
                </div>

                <div class="ei-control-group" style="margin-bottom: 12px;">
                    <label class="ei-label">Text to render</label>
                    <textarea class="ei-textarea" id="ei-test-text" placeholder="Type Kannada text here…">ಕರ್ನಾಟಕ</textarea>
                </div>

                <div class="ei-control-group" style="margin-bottom: 16px;">
                    <label class="ei-label">OpenType features</label>
                    <textarea class="ei-textarea" id="ei-features" placeholder='e.g. {"kern": 1, "liga": 0}' style="font-family: monospace; min-height: 40px;"></textarea>
                </div>

                <div class="ei-actions">
                    <button class="ei-btn ei-btn-primary" onclick="eiRender()" id="ei-render-btn">&#9654; Render</button>
                    <span class="ei-label">View mode:</span>
                    <div class="ei-mode-tabs">
                        <button class="ei-mode-tab active" data-mode="side-by-side" onclick="eiSetMode('side-by-side')">Side-by-side</button>
                        <button class="ei-mode-tab" data-mode="overlay" onclick="eiSetMode('overlay')">Overlay</button>
                    </div>
                </div>
            </div>

            <div id="ei-error"></div>

            <div id="ei-placeholder" class="ei-card" style="text-align: center; padding: 48px 16px;">
                <p style="font-size: 16px; margin-bottom: 8px;">&#9881; Engine Inspector</p>
                <p>Upload a font above and click <strong>Render</strong> to compare browser vs HarfBuzz rendering.</p>
            </div>

            <div id="ei-renders" style="display: none;"></div>

            <div id="ei-glyph-info" style="display: none;">
                <div class="ei-card">
                    <span class="ei-card-title">HarfBuzz Shaping Data</span>
                    <table class="ei-glyph-table">
                        <thead>
                            <tr>
                                <th>Glyph ID</th>
                                <th>Cluster</th>
                                <th>X Adv</th>
                                <th>Y Adv</th>
                                <th>X Off</th>
                                <th>Y Off</th>
                            </tr>
                        </thead>
                        <tbody id="ei-glyph-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="/">ಫಾಂಟ್ಗಳನ್ನು ಜಾಲಾಡಿ</a>
                <a href="/stats">ಅಂಕಿಅಂಶಗಳು</a>
                <a href="/about">ಯೋಜನೆಯ ಬಗ್ಗೆ</a>
                <a href="/bug-reports">Bug Reports</a>
                <a href="/getSuggestionForm">ಫಾಂಟನ್ನು ಸೂಚಿಸಿ</a>
            </div>
            <div class="footer-copyright">
                &copy; <%= new Date().getFullYear() %> ಸಂಚಯ ಮತ್ತು ಸಂಚಿ ಫೌಂಡೇಶನ್
            </div>
        </div>
    </footer>

    <script>
    var eiFontFace = null;
    var eiFontFile = null;
    var eiMode = 'side-by-side';

    function eiSetMode(m) {
        eiMode = m;
        document.querySelectorAll('.ei-mode-tab').forEach(function(t) {
            t.classList.toggle('active', t.dataset.mode === m);
        });
    }

    function eiShowError(msg) {
        var box = document.getElementById('ei-error');
        box.innerHTML = '<div class="ei-error-box">&#10060; ' + eiEscapeHtml(msg) + '</div>';
    }

    function eiClearError() {
        document.getElementById('ei-error').innerHTML = '';
    }

    function eiEscapeHtml(s) {
        return (s || '').replace(/[&<>"']/g, function(c) {
            var m = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            return m[c];
        });
    }

    function eiLoadFontFile(file) {
        eiFontFile = file;
        eiClearError();
        return file.arrayBuffer()
            .then(function(buf) {
                var ff = new FontFace(file.name, buf);
                return ff.load();
            })
            .then(function(ff) {
                eiFontFace = ff;
                document.fonts.add(ff);
                return ff;
            });
    }

    document.getElementById('ei-font-upload').addEventListener('change', function(e) {
        var file = e.target.files[0];
        if (!file) return;
        eiLoadFontFile(file).catch(function(err) {
            eiShowError('Could not load font in browser: ' + err.message);
        });
    });

    async function eiRender() {
        eiClearError();
        var btn = document.getElementById('ei-render-btn');
        var container = document.getElementById('ei-renders');
        var placeholder = document.getElementById('ei-placeholder');

        if (!eiFontFile) {
            eiShowError('Please upload a .ttf or .otf font file first.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="ei-spinner"></span> Rendering...';
        placeholder.style.display = 'none';
        container.style.display = 'block';
        container.innerHTML = '<div class="ei-loading">Rendering with HarfBuzz...</div>';

        try {
            var text = document.getElementById('ei-test-text').value;
            var fontSize = parseInt(document.getElementById('ei-font-size').value) || 72;
            var featuresStr = document.getElementById('ei-features').value;
            var features = {};

            if (featuresStr.trim()) {
                try { features = JSON.parse(featuresStr); }
                catch (e) { eiShowError('Invalid JSON in features: ' + e.message); btn.disabled = false; btn.innerHTML = '&#9654; Render'; return; }
            }

            var hb = await eiRenderHarfbuzz(text, fontSize, features);
            if (!hb.ok) { eiShowError('HarfBuzz render failed: ' + hb.error); btn.disabled = false; btn.innerHTML = '&#9654; Render'; return; }

            var bc = eiRenderBrowser(text, fontSize);

            if (eiMode === 'side-by-side') eiDisplaySideBySide(bc, hb);
            else eiDisplayOverlay(bc, hb);

            eiDisplayGlyphs(hb.glyphs, fontSize, hb.upem);
        } catch (err) { eiShowError(err.message); }
        finally { btn.disabled = false; btn.innerHTML = '&#9654; Render'; }
    }

    function eiRenderBrowser(text, fontSize) {
        var c = document.createElement('canvas');
        c.width = 700; c.height = 180;
        var ctx = c.getContext('2d');
        ctx.fillStyle = '#faf5f0'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.fillStyle = '#0f172a';
        ctx.font = (eiFontFace ? fontSize + 'px "' + eiFontFace.family + '", ' : '') + fontSize + 'px "Noto Sans Kannada", sans-serif';
        ctx.textBaseline = 'middle';
        var lines = text.split('\n');
        var lh = fontSize * 1.4;
        var sy = (c.height - (lines.length * lh)) / 2 + lh / 2;
        lines.forEach(function(l, i) { ctx.fillText(l, 20, sy + i * lh); });
        return c;
    }

    async function eiRenderHarfbuzz(text, fontSize, features) {
        var formData = new FormData();
        formData.append('fontFile', eiFontFile);
        formData.append('text', text);
        formData.append('fontSize', fontSize);
        if (Object.keys(features).length > 0) formData.append('features', JSON.stringify(features));

        var r = await fetch('/api/engine-inspector/upload-render', {
            method: 'POST',
            body: formData
        });
        var data = await r.json().catch(function() { return { error: r.statusText }; });
        if (!r.ok) throw new Error(data.error || r.statusText);
        return data;
    }

    function eiDisplaySideBySide(bc, hb) {
        var container = document.getElementById('ei-renders');
        container.innerHTML =
            '<div class="ei-render-grid">' +
                '<div class="ei-render-card"><span class="ei-render-label">&#127760; Your browser native</span><div class="ei-render-image"><canvas id="ei-browser-canvas" width="' + bc.width + '" height="' + bc.height + '"></canvas></div></div>' +
                '<div class="ei-render-card"><span class="ei-render-label">&#128209; HarfBuzz reference</span><div class="ei-render-image"><img src="' + hb.image + '" alt="HarfBuzz render" /></div></div>' +
            '</div>';
        document.getElementById('ei-browser-canvas').getContext('2d').drawImage(bc, 0, 0);
    }

    function eiDisplayOverlay(bc, hb) {
        var c = document.createElement('canvas');
        c.width = Math.max(bc.width, hb.width || 700); c.height = Math.max(bc.height, hb.height || 180);
        var ctx = c.getContext('2d');
        ctx.globalAlpha = 0.6; ctx.globalCompositeOperation = 'lighten'; ctx.drawImage(bc, 0, 0);
        var img = new Image();
        img.onload = function() {
            ctx.globalCompositeOperation = 'darken'; ctx.drawImage(img, 0, 0);
            document.getElementById('ei-renders').innerHTML =
                '<div class="ei-render-grid"><div class="ei-render-card"><span class="ei-render-label">&#127912; Overlay: <span style="color:#ef4444;">&#9632;</span> Browser vs <span style="color:#2563eb;">&#9632;</span> HarfBuzz</span><div class="ei-render-image"><canvas id="ei-overlay-canvas" width="' + c.width + '" height="' + c.height + '"></canvas></div></div></div>';
            document.getElementById('ei-overlay-canvas').getContext('2d').drawImage(c, 0, 0);
        };
        img.src = hb.image;
    }

    function eiDisplayGlyphs(glyphs, fontSize, upem) {
        var scale = fontSize / upem;
        document.getElementById('ei-glyph-body').innerHTML = glyphs.map(function(g) {
            return '<tr><td>' + g.glyph_id + '</td><td>' + g.cluster + '</td><td>' + (g.x_advance * scale).toFixed(1) + '</td><td>' + (g.y_advance * scale).toFixed(1) + '</td><td>' + (g.x_offset * scale).toFixed(1) + '</td><td>' + (g.y_offset * scale).toFixed(1) + '</td></tr>';
        }).join('');
        document.getElementById('ei-glyph-info').style.display = 'block';
    }

    function eiPopulateTestStrings() {
        fetch('/api/engine-inspector/test-strings')
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(data) {
                if (!data || !data.sets) return;
                var sel = document.getElementById('ei-test-string-select');
                data.sets.forEach(function(set) {
                    var optgroup = document.createElement('optgroup');
                    optgroup.label = set.label;
                    set.strings.forEach(function(s) {
                        var opt = document.createElement('option');
                        opt.value = s;
                        opt.textContent = s;
                        optgroup.appendChild(opt);
                    });
                    sel.appendChild(optgroup);
                });
                sel.addEventListener('change', function() {
                    if (sel.value) document.getElementById('ei-test-text').value = sel.value;
                });
            })
            .catch(function() {});
    }

    eiPopulateTestStrings();
    </script>
</body>
</html>
